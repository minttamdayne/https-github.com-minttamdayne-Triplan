# === LLM Provider ===
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
CHAT_MODEL=llama3.2
# === Neo4j Knowledge Graph ===
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# === Web Search (SerpAPI or Tavily) ===
SEARCH_API_KEY=xxx
SEARCH_PROVIDER=tavily

# === Geocoding (Google Maps) ===
GOOGLE_MAPS_API_KEY=xxx

# === App Settings ===
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=./data
